@model IEnumerable<FerreteriaWeb.Models.Kardex>
@{
    ViewData["Title"] = "Kárdex Valorizado";
    var prod = (FerreteriaWeb.Models.Producto?)ViewBag.ProductoSeleccionado;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">
            Kárdex Valorizado
        </h2>
        <p class="text-muted small mb-0">Control permanente de existencias valorizadas mediante el método de <strong>Costo Promedio Ponderado</strong> (formato SUNAT).</p>
    </div>
    <button onclick="window.print();" class="btn btn-outline-secondary">
        Imprimir Reporte
    </button>
</div>

<!-- Filtros de Producto y Fecha -->
<div class="card card-custom p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label fw-semibold small">Seleccionar Producto</label>
            <select name="productoId" class="form-select form-select-sm" asp-items="ViewBag.ProductoId" onchange="this.form.submit()">
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label fw-semibold small">Fecha Desde</label>
            <input type="date" name="desde" value="@ViewBag.Desde" class="form-control form-control-sm" />
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label fw-semibold small">Fecha Hasta</label>
            <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control form-control-sm" />
        </div>
        <div class="col-12 col-md-1">
            <button type="submit" class="btn btn-dark btn-sm w-100 fw-semibold">Filtrar</button>
        </div>
    </form>
</div>

@if (prod != null)
{
    <!-- Tarjeta Informativa del Producto -->
    <div class="card card-custom p-3 mb-4 bg-light">
        <div class="row align-items-center">
            <div class="col-md-6">
                <span class="badge bg-secondary mb-1">@prod.Codigo</span>
                <h5 class="fw-bold text-dark mb-0">@prod.Descripcion</h5>
                <small class="text-muted">Unidad: @prod.UnidadMedida?.Nombre (@prod.UnidadMedida?.Abreviatura)</small>
            </div>
            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                <div class="d-inline-block text-start me-4">
                    <small class="text-muted d-block">Stock Disponible</small>
                    <span class="fs-5 fw-bold text-success">@prod.StockActual.ToString("G29") @prod.UnidadMedida?.Abreviatura</span>
                </div>
                <div class="d-inline-block text-start">
                    <small class="text-muted d-block">Costo Promedio Vigente</small>
                    <span class="fs-5 fw-bold text-primary">S/ @prod.CostoPromedio.ToString("N4")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Kárdex Valorizado Estilo SUNAT 13.1 -->
    <div class="card card-custom overflow-hidden">
        <div class="table-responsive">
            <table class="table table-bordered table-sm table-hover mb-0 text-center align-middle" style="font-size: 0.85rem;">
                <thead class="table-dark">
                    <tr>
                        <th rowspan="2" class="align-middle">Fecha</th>
                        <th rowspan="2" class="align-middle">Operación</th>
                        <th rowspan="2" class="align-middle">Comprobante</th>
                        <th colspan="3" class="bg-success text-white border-bottom-0">Entradas</th>
                        <th colspan="3" class="bg-danger text-white border-bottom-0">Salidas</th>
                        <th colspan="3" class="bg-primary text-white border-bottom-0">Saldo Final</th>
                    </tr>
                    <tr>
                        <th class="bg-success text-white">Cant.</th>
                        <th class="bg-success text-white">C. Unit</th>
                        <th class="bg-success text-white">Total</th>

                        <th class="bg-danger text-white">Cant.</th>
                        <th class="bg-danger text-white">C. Unit</th>
                        <th class="bg-danger text-white">Total</th>

                        <th class="bg-primary text-white">Cant.</th>
                        <th class="bg-primary text-white">C. Prom</th>
                        <th class="bg-primary text-white">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var k in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@k.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(k.Operacion.Contains("Entrada") ? "bg-success" : (k.Operacion.Contains("Salida") ? "bg-danger" : "bg-warning text-dark"))">
                                        @k.Operacion
                                    </span>
                                </td>
                                <td class="fw-semibold">@k.DocumentoRef</td>

                                <!-- Entradas -->
                                <td class="table-success">@(k.CantidadEntrada > 0 ? k.CantidadEntrada.ToString("G29") : "-")</td>
                                <td class="table-success">@(k.CantidadEntrada > 0 ? "S/ " + k.CostoEntrada.ToString("N2") : "-")</td>
                                <td class="table-success fw-bold">@(k.TotalEntrada > 0 ? "S/ " + k.TotalEntrada.ToString("N2") : "-")</td>

                                <!-- Salidas -->
                                <td class="table-danger">@(k.CantidadSalida > 0 ? k.CantidadSalida.ToString("G29") : "-")</td>
                                <td class="table-danger">@(k.CantidadSalida > 0 ? "S/ " + k.CostoSalida.ToString("N2") : "-")</td>
                                <td class="table-danger fw-bold">@(k.TotalSalida > 0 ? "S/ " + k.TotalSalida.ToString("N2") : "-")</td>

                                <!-- Saldo Final -->
                                <td class="table-primary fw-bold">@k.SaldoCantidad.ToString("G29")</td>
                                <td class="table-primary">S/ @k.CostoPromedio.ToString("N4")</td>
                                <td class="table-primary fw-bold text-dark">S/ @k.SaldoTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center py-4 text-muted">
                                No se encontraron registros de kárdex para los filtros aplicados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
