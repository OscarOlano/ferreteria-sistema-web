@model IEnumerable<FerreteriaWeb.Models.Movimiento>
@{
    ViewData["Title"] = "Historial de Movimientos";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">
            Historial de Movimientos
        </h2>
        <p class="text-muted small mb-0">Registro y trazabilidad de todas las operaciones de entrada, salida y ajustes de inventario realizadas en el almacén.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Entrada" class="btn btn-sm btn-success">Entrada</a>
        <a asp-action="Salida" class="btn btn-sm btn-danger">Salida</a>
        <a asp-action="Ajuste" class="btn btn-sm btn-warning text-dark">Ajuste Físico</a>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>N.° Operación</th>
                    <th>Tipo</th>
                    <th>Fecha y Hora</th>
                    <th>Documento Ref.</th>
                    <th>Proveedor / Motivo</th>
                    <th>Usuario Responsable</th>
                    <th class="text-end">Monto Total</th>
                    <th class="text-center">Artículos</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@m.Id.ToString("00000")</td>
                            <td>
                                @if (m.Tipo == FerreteriaWeb.Models.TipoMovimiento.Entrada)
                                {
                                    <span class="badge bg-success">Entrada</span>
                                }
                                else if (m.Tipo == FerreteriaWeb.Models.TipoMovimiento.Salida)
                                {
                                    <span class="badge bg-danger">Salida</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Ajuste Físico</span>
                                }
                            </td>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@m.DocumentoReferencia</td>
                            <td>@(m.Proveedor?.RazonSocial ?? m.Motivo)</td>
                            <td>@(m.Usuario?.NombreCompleto ?? "Sistema")</td>
                            <td class="text-end fw-bold">S/ @m.MontoTotal.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    @m.Detalles.Count
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            No se registran movimientos de inventario.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
