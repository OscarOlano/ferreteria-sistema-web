@model FerreteriaWeb.Services.DashboardViewModel
@{
    ViewData["Title"] = "Panel de Control";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 text-warning me-2"></i>Panel de Control de Almacén
        </h2>
        <p class="text-muted mb-0">Resumen en tiempo real del inventario, valorizaciones y alertas operativas.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Inventario" asp-action="Entrada" class="btn btn-success shadow-sm d-flex align-items-center gap-2 fw-semibold">
            <i class="bi bi-box-arrow-in-down"></i> Nueva Entrada
        </a>
        <a asp-controller="Inventario" asp-action="Salida" class="btn btn-danger shadow-sm d-flex align-items-center gap-2 fw-semibold">
            <i class="bi bi-box-arrow-up-right"></i> Nueva Salida
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-warning h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Valor del Inventario</span>
                    <h3 class="fw-bold mt-2 mb-0 text-dark">S/ @Model.ValorTotalInventario.ToString("N2")</h3>
                    <small class="text-success fw-medium"><i class="bi bi-calculator"></i> Costo promedio ponderado</small>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-primary h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Productos</span>
                    <h3 class="fw-bold mt-2 mb-0 text-dark">@Model.TotalProductos</h3>
                    <small class="text-muted"><i class="bi bi-tags"></i> En catálogo activo</small>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-danger h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Alertas de Stock</span>
                    <h3 class="fw-bold mt-2 mb-0 @(Model.ProductosStockBajo > 0 ? "text-danger" : "text-dark")">
                        @Model.ProductosStockBajo
                    </h3>
                    <small class="text-danger fw-medium"><i class="bi bi-exclamation-circle"></i> Por debajo del mínimo</small>
                </div>
                <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-danger">
                    <i class="bi bi-bell-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card card-custom p-3 border-start border-4 border-success h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Movimientos Hoy</span>
                    <h3 class="fw-bold mt-2 mb-0 text-dark">@Model.MovimientosHoy</h3>
                    <small class="text-muted"><i class="bi bi-arrow-repeat"></i> Entradas y salidas</small>
                </div>
                <div class="p-3 bg-success bg-opacity-10 rounded-3 text-success">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Tabla de Alertas de Stock Crítico -->
    <div class="col-12 col-lg-7">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-0 pt-3 pb-2 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Productos con Stock Bajo o Crítico
                </h5>
                <a asp-controller="Inventario" asp-action="Alertas" class="btn btn-sm btn-outline-secondary">Ver todas</a>
            </div>
            <div class="card-body p-0">
                @if (Model.AlertasStock.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-custom table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th class="text-center">Stock</th>
                                    <th class="text-center">Mínimo</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.AlertasStock.Take(6))
                                {
                                    <tr>
                                        <td class="fw-semibold text-secondary">@item.Codigo</td>
                                        <td>
                                            <div class="fw-bold text-dark">@item.Descripcion</div>
                                            <small class="text-muted">@item.Categoria?.Nombre</small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(item.StockActual <= 0 ? "bg-danger" : "bg-warning text-dark") fs-6 px-2 py-1">
                                                @item.StockActual.ToString("G29") @item.UnidadMedida?.Abreviatura
                                            </span>
                                        </td>
                                        <td class="text-center fw-semibold text-muted">
                                            @item.StockMinimo.ToString("G29")
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Inventario" asp-action="Entrada" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-plus-circle"></i> Reponer
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-check text-success fs-1"></i>
                        <p class="mt-2 mb-0">Todos los productos tienen niveles de stock adecuados.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Categorías y Últimos Movimientos -->
    <div class="col-12 col-lg-5">
        <div class="card card-custom mb-4">
            <div class="card-header bg-white border-0 pt-3 pb-2 px-4">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i>Distribución por Categorías
                </h5>
            </div>
            <div class="card-body px-4 pt-1">
                <div class="list-group list-group-flush">
                    @foreach (var cat in Model.ProductosPorCategoria)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-light">
                            <span class="fw-medium text-dark"><i class="bi bi-folder2 text-warning me-2"></i>@cat.Key</span>
                            <span class="badge bg-secondary rounded-pill">@cat.Value productos</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card card-custom">
            <div class="card-header bg-white border-0 pt-3 pb-2 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-secondary me-2"></i>Últimos Movimientos
                </h5>
                <a asp-controller="Inventario" asp-action="Movimientos" class="small text-decoration-none">Ver historial</a>
            </div>
            <div class="card-body px-4 pt-1 pb-3">
                @if (Model.UltimosMovimientos.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var mov in Model.UltimosMovimientos)
                        {
                            <div class="list-group-item px-0 py-2 border-light d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge @(mov.Tipo == FerreteriaWeb.Models.TipoMovimiento.Entrada ? "bg-success" : "bg-danger") me-1">
                                        @mov.Tipo
                                    </span>
                                    <span class="fw-semibold text-dark">@mov.DocumentoReferencia</span>
                                    <div class="small text-muted">@mov.Fecha.ToString("dd/MM/yyyy HH:mm") &bull; @mov.Motivo</div>
                                </div>
                                <span class="fw-bold text-dark">S/ @mov.MontoTotal.ToString("N2")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No se registran movimientos recientes.</p>
                }
            </div>
        </div>
    </div>
</div>
