@model FerreteriaWeb.Models.Producto
@{
    ViewData["Title"] = "Desactivar Producto";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <div class="card card-custom p-4 border-danger">
            <div class="text-center mb-3">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                <h4 class="fw-bold text-dark mt-2">¿Desactivar este producto?</h4>
                <p class="text-muted small">El producto no se eliminará físicamente para proteger el historial de transacciones y el kárdex valorizado, pero ya no aparecerá en el catálogo para nuevas ventas.</p>
            </div>

            <div class="bg-light p-3 rounded-3 mb-4">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Código:</span>
                    <span class="fw-bold">@Model.Codigo</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Descripción:</span>
                    <span class="fw-semibold">@Model.Descripcion</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Stock actual:</span>
                    <span class="fw-bold">@Model.StockActual</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Categoría:</span>
                    <span>@(Model.Categoria?.Nombre ?? "N/A")</span>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger fw-semibold">
                    <i class="bi bi-trash me-1"></i> Confirmar Desactivación
                </button>
            </form>
        </div>
    </div>
</div>
