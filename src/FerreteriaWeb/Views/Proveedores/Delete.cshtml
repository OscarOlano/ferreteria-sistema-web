@model FerreteriaWeb.Models.Proveedor
@{
    ViewData["Title"] = "Desactivar Proveedor";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <div class="card card-custom p-4 border-danger">
            <div class="text-center mb-3">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                <h4 class="fw-bold text-dark mt-2">¿Desactivar Proveedor?</h4>
                <p class="text-muted small">El proveedor se marcará como inactivo para no perder la trazabilidad de las órdenes y entradas registradas.</p>
            </div>

            <div class="bg-light p-3 rounded-3 mb-4">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">RUC:</span>
                    <span class="fw-bold">@Model.Ruc</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Razón Social:</span>
                    <span class="fw-semibold">@Model.RazonSocial</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Teléfono:</span>
                    <span>@(Model.Telefono ?? "N/A")</span>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger fw-semibold">
                    <i class="bi bi-trash me-1"></i> Desactivar
                </button>
            </form>
        </div>
    </div>
</div>
