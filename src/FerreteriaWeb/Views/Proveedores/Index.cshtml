@model IEnumerable<FerreteriaWeb.Models.Proveedor>
@{
    ViewData["Title"] = "Directorio de Proveedores";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">
            Directorio de Proveedores
        </h2>
        <p class="text-muted small mb-0">Gestión de empresas proveedoras de materiales, insumos y herramientas.</p>
    </div>
    <a asp-action="Create" class="btn btn-brand">
        Nuevo Proveedor
    </a>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>RUC</th>
                    <th>Razón Social</th>
                    <th>Teléfono</th>
                    <th>Correo Electrónico</th>
                    <th>Dirección</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.Ruc</td>
                            <td class="fw-semibold text-dark">@item.RazonSocial</td>
                            <td>@(item.Telefono ?? "N/A")</td>
                            <td><a href="mailto:@item.Email" class="text-decoration-none">@(item.Email ?? "N/A")</a></td>
                            <td class="text-muted small">@(item.Direccion ?? "N/A")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                        Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Desactivar">
                                        Baja
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No se registran proveedores activos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
