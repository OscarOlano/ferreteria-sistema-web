@model FerreteriaWeb.Models.OrdenCompra
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Orden de Compra @Model.NumeroOrden - FerreAlmacén</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #ffffff;
            color: #1e293b;
            padding: 30px;
        }

        .header-box {
            border-bottom: 3px solid #d97706;
            padding-bottom: 20px;
            margin-bottom: 25px;
        }

        .oc-number-box {
            border: 2px solid #d97706;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            background: #fef3c7;
        }

        .table-items th {
            background-color: #f1f5f9;
            border-bottom: 2px solid #cbd5e1;
        }

        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="no-print d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded border">
        <div>
            <strong>Vista de Impresión / Exportación a PDF</strong> (CU-06)
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-primary btn-sm me-2">
                <i class="bi bi-printer me-1"></i> Imprimir / Guardar como PDF
            </button>
            <button onclick="window.close()" class="btn btn-secondary btn-sm">
                Cerrar
            </button>
        </div>
    </div>

    <!-- Cabecera Institucional -->
    <div class="row header-box align-items-center">
        <div class="col-8">
            <h2 class="fw-bold mb-1" style="color: #d97706;">FERRETERÍA EL CONSTRUCTOR S.A.C.</h2>
            <div class="small text-muted">RUC: 20601234567 &bull; Venta de Materiales de Construcción y Ferretería</div>
            <div class="small text-muted"><i class="bi bi-geo-alt"></i> Sede Operativa: Av. Néstor Gambetta Km 14.5, Ventanilla, Callao - Perú</div>
            <div class="small text-muted"><i class="bi bi-telephone"></i> Central: (01) 555-8920 &bull; Email: logistica@ferrealmacen.pe</div>
        </div>
        <div class="col-4">
            <div class="oc-number-box">
                <div class="small fw-bold text-uppercase text-secondary">Orden de Compra Oficial</div>
                <div class="fs-4 fw-bold text-dark">@Model.NumeroOrden</div>
                <div class="small text-muted">Fecha: @Model.FechaEmision.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>

    <!-- Información del Proveedor y Despacho -->
    <div class="row mb-4">
        <div class="col-6">
            <div class="card p-3 border">
                <h6 class="fw-bold text-secondary border-bottom pb-1 mb-2">DATOS DEL PROVEEDOR</h6>
                <div><strong>Razón Social:</strong> @Model.Proveedor?.RazonSocial</div>
                <div><strong>RUC:</strong> @Model.Proveedor?.Ruc</div>
                <div><strong>Teléfono:</strong> @(Model.Proveedor?.Telefono ?? "—")</div>
                <div><strong>Email:</strong> @(Model.Proveedor?.Email ?? "—")</div>
                <div><strong>Dirección:</strong> @(Model.Proveedor?.Direccion ?? "—")</div>
            </div>
        </div>
        <div class="col-6">
            <div class="card p-3 border">
                <h6 class="fw-bold text-secondary border-bottom pb-1 mb-2">CONDICIONES DE ENTREGA</h6>
                <div><strong>Lugar de Entrega:</strong> Almacén Central Ventanilla</div>
                <div><strong>Fecha Esperada:</strong> @(Model.FechaEsperada?.ToString("dd/MM/yyyy") ?? "Inmediata")</div>
                <div><strong>Emitida Por:</strong> @Model.Usuario?.NombreCompleto</div>
                <div><strong>Estado de la Orden:</strong> <span class="badge bg-secondary">@Model.Estado</span></div>
                <div><strong>Moneda:</strong> Nuevos Soles (PEN - S/)</div>
            </div>
        </div>
    </div>

    <!-- Detalle de Artículos -->
    <table class="table table-bordered table-items mb-4">
        <thead>
            <tr>
                <th style="width: 5%;">Item</th>
                <th style="width: 15%;">Código</th>
                <th style="width: 45%;">Descripción del Material</th>
                <th style="width: 10%;">U.M.</th>
                <th style="width: 10%;" class="text-end">Cantidad</th>
                <th style="width: 15%;" class="text-end">Precio Unit. (S/)</th>
                <th style="width: 15%;" class="text-end">Subtotal (S/)</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; }
            @foreach (var det in Model.Detalles)
            {
                <tr>
                    <td class="text-center">@(i++)</td>
                    <td><code>@det.Producto?.Codigo</code></td>
                    <td><strong>@det.Producto?.Descripcion</strong></td>
                    <td class="text-center">@det.Producto?.UnidadMedida?.Abreviatura</td>
                    <td class="text-end">@det.Cantidad.ToString("N2")</td>
                    <td class="text-end">S/ @det.PrecioUnitario.ToString("N2")</td>
                    <td class="text-end fw-bold">S/ @det.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="6" class="text-end fs-6">SUBTOTAL NETO:</th>
                <th class="text-end fs-6">S/ @((Model.MontoTotal / 1.18m).ToString("N2"))</th>
            </tr>
            <tr>
                <th colspan="6" class="text-end fs-6">I.G.V. (18%):</th>
                <th class="text-end fs-6">S/ @((Model.MontoTotal - (Model.MontoTotal / 1.18m)).ToString("N2"))</th>
            </tr>
            <tr class="table-warning">
                <th colspan="6" class="text-end fs-5">TOTAL GENERAL:</th>
                <th class="text-end fs-5 text-dark fw-bold">S/ @Model.MontoTotal.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>

    @if (!string.IsNullOrEmpty(Model.Observaciones))
    {
        <div class="mb-4 p-3 border rounded bg-light">
            <strong>Observaciones de Logística:</strong>
            <div>@Model.Observaciones</div>
        </div>
    }

    <!-- Firmas de Autorización -->
    <div class="row text-center mt-5 pt-4">
        <div class="col-4">
            <div class="border-top pt-2">
                <div class="fw-bold">@Model.Usuario?.NombreCompleto</div>
                <div class="small text-muted">Jefe de Almacén / Emisor</div>
            </div>
        </div>
        <div class="col-4">
            <div class="border-top pt-2">
                <div class="fw-bold">Gerencia de Operaciones</div>
                <div class="small text-muted">Ferretería El Constructor S.A.C.</div>
            </div>
        </div>
        <div class="col-4">
            <div class="border-top pt-2">
                <div class="fw-bold">@Model.Proveedor?.RazonSocial</div>
                <div class="small text-muted">Conformidad del Proveedor</div>
            </div>
        </div>
    </div>
</div>

</body>
</html>

