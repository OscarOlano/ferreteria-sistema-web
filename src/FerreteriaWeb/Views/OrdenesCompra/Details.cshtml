@model FerreteriaWeb.Models.OrdenCompra
@{
    ViewData["Title"] = $"Orden de Compra {Model.NumeroOrden}";
    var subtotalNeto = Model.MontoTotal / 1.18m;
    var igv = Model.MontoTotal - subtotalNeto;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-3">
            <h3 class="h4 fw-bold mb-0 text-dark">
                Orden de Compra: @Model.NumeroOrden
            </h3>
            @if (Model.Estado == "Pendiente")
            {
                <span class="badge bg-warning text-dark px-3 py-2">Pendiente</span>
            }
            else if (Model.Estado == "Aprobada")
            {
                <span class="badge bg-info text-dark px-3 py-2">Aprobada</span>
            }
            else if (Model.Estado == "Recibida")
            {
                <span class="badge bg-success px-3 py-2">Mercadería Recibida</span>
            }
            else
            {
                <span class="badge bg-danger px-3 py-2">Anulada</span>
            }
        </div>
        <p class="text-secondary small mb-0 mt-1">
            Emitida el @Model.FechaEmision.ToString("dd/MM/yyyy HH:mm") por @Model.Usuario?.NombreCompleto (@Model.Usuario?.Email)
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Listado
        </a>
        <a asp-action="Imprimir" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary">
            Imprimir / PDF
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Información de Proveedor y Logística -->
    <div class="col-lg-4">
        <div class="card card-custom p-4 border-0 shadow-sm mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Datos del Proveedor
            </h5>
            <div class="mb-2">
                <span class="text-muted small d-block">Razón Social:</span>
                <span class="fw-bold text-dark">@Model.Proveedor?.RazonSocial</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">RUC:</span>
                <span class="badge bg-light text-dark border font-monospace">@Model.Proveedor?.Ruc</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Teléfono / Contacto:</span>
                <span>@(Model.Proveedor?.Telefono ?? "No registrado")</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Dirección Fiscal:</span>
                <span>@(Model.Proveedor?.Direccion ?? "Callao / Lima")</span>
            </div>
        </div>

        <div class="card card-custom p-4 border-0 shadow-sm">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Logística de Entrega
            </h5>
            <div class="mb-2">
                <span class="text-muted small d-block">Fecha Estimada de Llegada:</span>
                <span class="fw-semibold">@(Model.FechaEsperada?.ToString("dd/MM/yyyy") ?? "Por confirmar")</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Destino de Recepción:</span>
                <span>Almacén Central Ventanilla (Av. Néstor Gambetta Km 14.5)</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Observaciones:</span>
                <span class="text-muted">@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Ninguna observación registrada." : Model.Observaciones)</span>
            </div>
        </div>
    </div>

    <!-- Detalle de Artículos y Totales -->
    <div class="col-lg-8">
        <div class="card card-custom border-0 shadow-sm overflow-hidden mb-4">
            <div class="card-header bg-white border-0 pt-3 pb-2 px-4">
                <h5 class="fw-bold mb-0 text-dark">Artículos Solicitados</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">P. Unit.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var det in Model.Detalles)
                        {
                            <tr>
                                <td class="fw-bold text-muted font-monospace">@det.Producto?.Codigo</td>
                                <td>
                                    <div class="fw-semibold text-dark">@det.Producto?.Descripcion</div>
                                    <small class="text-muted">@det.Producto?.Marca?.Nombre</small>
                                </td>
                                <td class="text-center fw-bold">@det.Cantidad.ToString("G29") @det.Producto?.UnidadMedida?.Abreviatura</td>
                                <td class="text-end">S/ @det.PrecioUnitario.ToString("N2")</td>
                                <td class="text-end fw-bold text-dark">S/ @det.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totales -->
            <div class="p-3 bg-light border-top">
                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <table class="table table-sm table-borderless text-end mb-0">
                            <tr>
                                <td class="text-muted">Subtotal Neto:</td>
                                <td class="fw-semibold">S/ @subtotalNeto.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">I.G.V. (18%):</td>
                                <td class="fw-semibold">S/ @igv.ToString("N2")</td>
                            </tr>
                            <tr class="border-top">
                                <td class="fw-bold fs-5 text-dark">Total:</td>
                                <td class="fw-bold fs-5 text-brand">S/ @Model.MontoTotal.ToString("N2")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Estado == "Pendiente" || Model.Estado == "Aprobada")
        {
            <div class="card card-custom p-3 border-0 bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>¿Mercadería recibida en almacén?</strong>
                        <div class="text-muted small">Puede recepcionar estos artículos directamente vinculando esta orden en el módulo de entradas.</div>
                    </div>
                    <a asp-controller="Inventario" asp-action="Entrada" class="btn btn-success">
                        Recepcionar Entrada
                    </a>
                </div>
            </div>
        }
    </div>
</div>
